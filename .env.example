# Copy to .env and fill in. NEVER commit .env. Every value here is read ONLY by copilot/config.py.

# ---- Secrets (required for real runs; not needed for unit tests) ----
GROQ_API_KEY=
PINECONE_API_KEY=
TAVILY_API_KEY=

# ---- Groq LLM ----
# Model names change over time: confirm a current one at https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.0
# Optional nucleus sampling (0 < value <= 1). Leave empty for the provider default. Little effect at temperature 0.
GROQ_TOP_P=
GROQ_TIMEOUT_S=30
GROQ_MAX_RETRIES=2
# low|medium|high for reasoning models such as openai/gpt-oss-*; leave empty for other models
GROQ_REASONING_EFFORT=low
LLM_MAX_TOKENS=2048
EVIDENCE_MAX_CHARS=3000

# ---- Embeddings (local, no API key) ----
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ---- Pinecone (serverless, cosine) ----
PINECONE_INDEX_NAME=it-support-copilot
PINECONE_NAMESPACE=kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---- Tavily (public web search, only as a graded fallback) ----
EXTERNAL_SEARCH_ENABLED=true
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic
TAVILY_TIMEOUT_S=15
EXTERNAL_CONTENT_MAX_CHARS=1500
MAX_EXTERNAL_QUERY_CHARS=200
# JSON list of internal names removed from public search queries
PRIVATE_TERMS=["Acme Demo Corp", "Acme", "SecureLink"]

# ---- Retrieval + grading thresholds ----
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.25
# Optional reranker: fetch RERANK_CANDIDATES chunks, re-score with a local cross-encoder, keep RETRIEVAL_TOP_K.
# First use downloads the model (needs network once; the Docker image bakes it in).
RERANK_ENABLED=false
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20
PRIVATE_EVIDENCE_THRESHOLD=0.6
EXTERNAL_EVIDENCE_THRESHOLD=0.6

# ---- Loop bounds ----
MAX_REWRITE_RETRIES=2
MAX_VALIDATION_REVISIONS=1
GRAPH_RECURSION_LIMIT=40

# ---- Embedding batching / external-call resilience ----
EMBEDDING_BATCH_SIZE=32
PINECONE_UPSERT_BATCH_SIZE=100
SERVICE_MAX_RETRIES=2
SERVICE_RETRY_BASE_DELAY_S=0.5

# ---- Ingestion ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_UPLOAD_MB=10

# ---- Storage / logging ----
SQLITE_PATH=data/sqlite/app.db
KB_DOCUMENTS_DIR=data/kb_documents
EVAL_DIR=data/eval
UPLOADS_DIR=data/uploads
LOG_LEVEL=INFO
LOG_JSON=true

# ---- Local demo auth (NOT production identity management) ----
DEFAULT_ROLE=employee

SERVICE_RETRY_MAX_DELAY_S=30

# ---- API ----
MAX_QUESTION_CHARS=2000
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
UI_REQUEST_TIMEOUT_S=180
UI_EVAL_REFRESH_S=5

# ---- Evaluation ----
EVAL_CASE_DELAY_S=0
EVAL_MAX_CONSECUTIVE_ERRORS=3
PRICE_LLM_INPUT_PER_MTOK=0.15
PRICE_LLM_OUTPUT_PER_MTOK=0.60
PRICE_TAVILY_PER_SEARCH=0.008
