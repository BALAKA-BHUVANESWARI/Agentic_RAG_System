# Secrets and local environments must never enter the image.
.env
.env.*
!.env.example
.venv/
.venv-*/
venv/

# Version control and editors
.git
.gitignore
.vscode/
.idea/
.DS_Store

# Python and test artefacts
**/__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Runtime data lives in Docker volumes, not in the image
data/sqlite/*
data/uploads/*
data/eval/results/*

# Docker files themselves
Dockerfile
docker-compose.yml
.dockerignore
